# xiaowen-core configuration — copy to .env for local dev (never commit real secrets)

CORE_ADDR=:8080
CORE_DB_PATH=/tmp/core.db
CORE_BASE_URL=http://localhost:8080
CORE_SITE_URL=http://localhost:1313
CORE_ENV=dev

# Admin console token. Empty = admin refuses login. REQUIRED in prod.
CORE_ADMIN_TOKEN=

# SMTP. 465 = implicit TLS, 587 = STARTTLS. Empty host in dev = log-only mailer.
CORE_SMTP_HOST=
CORE_SMTP_PORT=587
CORE_SMTP_USER=
CORE_SMTP_PASS=
CORE_SMTP_FROM=三杯过后 <letter@example.com>

# Cloudflare R2 — MEDIA bucket (S3 API). These are the FALLBACK for the media
# target: the admin console「系统参数」page (settings table) takes precedence
# field by field, so existing deployments keep working and console edits
# override without a restart. Backups have no env fallback — configure them
# in the console only.
CORE_R2_ENDPOINT=
CORE_R2_KEY_ID=
CORE_R2_SECRET=
CORE_R2_BUCKET=
CORE_R2_PUBLIC_BASE=

# Cloudflare Turnstile. Empty = dev mode skips verification (WARN logged).
CORE_TURNSTILE_SECRET=

# Trusted reverse proxies (comma-separated CIDRs/IPs, e.g. "10.0.0.0/8,1.2.3.4").
# Only these peers' X-Forwarded-For headers are honored for client IP.
# Empty (default) = never trust XFF; the direct peer address is used.
CORE_TRUSTED_PROXIES=

# Newsletter pacing between recipients (milliseconds, default 1000 = 1/sec).
CORE_SEND_INTERVAL_MS=1000

# Physical mailing address shown in newsletter footers (anti-spam compliance).
CORE_MAILING_ADDRESS=
